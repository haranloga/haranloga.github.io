# Keep all text files with LF line endings in the repository
# This prevents Windows git from converting LF→CRLF and rejecting commits
* text=auto eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.gif binary
*.mp4 binary
*.webm binary
*.mov binary
*.pdf binary
